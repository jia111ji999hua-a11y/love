<view class="page" wx:if="{{car}}"><swiper class="swiper"><swiper-item wx:for="{{car.images}}" wx:key="*this"><image src="{{item}}" mode="aspectFill"/></swiper-item></swiper><view class="card"><view class="h">{{car.brand}} {{car.series}}</view><view class="muted">{{car.year}}年 · {{car.mileage}}万公里 · {{car.color}}</view><view class="price">¥{{car.price}}</view><view>{{car.condition}}</view></view><view class="card"><view class="h">分期/以租代购方案</view><view wx:for="{{car.plans}}" wx:key="*this" class="plan">首付 ¥{{item.downPayment}} · 月供 ¥{{item.monthlyPayment}} · {{item.term}}期 · 保证金 ¥{{item.deposit}}</view></view><view class="card"><view class="h">预约看车 / 留资</view><input class="input" placeholder="姓名（选填）" bindinput="name"/><input class="input" type="number" placeholder="手机号" bindinput="phone"/><button class="btn" bindtap="submit">提交后我们会尽快联系您</button><navigator url="/pages/privacy/privacy" class="privacy">隐私协议</navigator></view></view>
