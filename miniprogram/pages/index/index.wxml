<view class="page"><view class="hero"><view class="title">精选二手车</view><view class="muted">车况透明 · 方案清晰 · 安心购车</view></view><view class="search"><input class="input" placeholder="搜索品牌/车系" bindconfirm="load" value="{{keyword}}" bindinput="input"/><button size="mini" bindtap="load">搜索</button></view><view wx:if="{{!cars.length}}" class="card muted">暂无在售车辆</view><view wx:for="{{cars}}" wx:key="_id" class="card" bindtap="go" data-id="{{item._id}}"><image wx:if="{{item.images[0]}}" src="{{item.images[0]}}" mode="aspectFill" class="cover"/><view class="car-title">{{item.brand}} {{item.series}}</view><view class="muted">{{item.year}}年 · {{item.mileage}}万公里 · {{item.color}}</view><view class="price">¥{{item.price}} <text class="muted">起，月供 ¥{{item.plan.monthlyPayment}}</text></view></view></view>
