<view class="page"><view wx:if="{{!isAdmin}}" class="card"><view class="h">管理员登录</view><input class="input" password placeholder="管理员口令" bindinput="code"/><button class="btn" bindtap="login">登录</button></view><view wx:else><view class="card"><view class="h">车辆库存</view><input class="input" placeholder="品牌" bindinput="field" data-key="brand"/><input class="input" placeholder="车系" bindinput="field" data-key="series"/><input class="input" placeholder="售价" bindinput="field" data-key="price"/><button class="btn" bindtap="save">新增车辆</button></view><view wx:for="{{vehicles}}" wx:key="_id" class="card">{{item.brand}} {{item.series}} · ¥{{item.price}}</view></view></view>
